generator client { provider="prisma-client-js" }
datasource db { provider="postgresql"; url=env("DATABASE_URL") }
enum Level { L1 L2 }
enum ResourceType { COURSE TD TP EXERCISE CORRECTION }
model User { id String @id @default(cuid()); name String; email String @unique; passwordHash String; level Level?; role String @default("STUDENT"); favorites Favorite[];
  attempts Attempt[];
  chatMessages ChatMessage[]; createdAt DateTime @default(now()) }
model Subject { id String @id @default(cuid()); name String; level Level; resources Resource[]; quizzes Quiz[]; createdAt DateTime @default(now()) }
model Resource { id String @id @default(cuid()); title String; description String?; type ResourceType; level Level; subjectId String; fileUrl String?
  openaiFileId String?; subject Subject @relation(fields:[subjectId],references:[id],onDelete:Cascade); favorites Favorite[]; createdAt DateTime @default(now()) }
model Setting { key String @id; value String }
model Quiz {
  id String @id @default(cuid())
  title String
  description String?
  level Level
  subjectId String
  subject Subject @relation(fields:[subjectId],references:[id],onDelete:Cascade)
  questions Question[]
  attempts Attempt[]
  createdAt DateTime @default(now())
}
model Question {
  id String @id @default(cuid())
  quizId String
  text String
  options String
  answerIndex Int
  explanation String?
  quiz Quiz @relation(fields:[quizId],references:[id],onDelete:Cascade)
}
model Attempt {
  id String @id @default(cuid())
  userId String
  quizId String
  score Int
  total Int
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  quiz Quiz @relation(fields:[quizId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
}
model ChatMessage {
  id String @id @default(cuid())
  userId String?
  role String
  content String
  level Level?
  user User? @relation(fields:[userId],references:[id],onDelete:SetNull)
  createdAt DateTime @default(now())
}
model Favorite { id String @id @default(cuid()); userId String; resourceId String; user User @relation(fields:[userId],references:[id],onDelete:Cascade); resource Resource @relation(fields:[resourceId],references:[id],onDelete:Cascade); @@unique([userId,resourceId]) }
